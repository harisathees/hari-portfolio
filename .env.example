# AI chatbot (bottom-right robot). Copy this file to .env.local and fill in at least ONE key.
# Keys stay on the server — they are never sent to the browser.

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# xAI Grok — get a key at https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

# Groq (fast open models) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Which provider to try first: gemini | grok | groq.
# If it fails, the bot automatically falls back to the next provider that has a key.
AI_PROVIDER=gemini
